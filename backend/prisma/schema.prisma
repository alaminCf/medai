generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            String    @default("student")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        PracticeSession[]
  examAttempts    ExamAttempt[]

  @@map("users")
}

model PatientCase {
  id                  String             @id @default(uuid())
  title               String
  slug                String             @unique
  description         String?
  category            String             @default("General Medicine")
  difficulty          String             @default("beginner")
  estimatedDuration   Int                @default(20)
  patientName         String
  patientAge          Int
  patientGender       String
  chiefComplaint      String
  caseSummary         String?
  personality         String             @default("calm")
  isActive            Boolean            @default(true)
  
  // Phase 2: Patient Voice Profile
  voiceProvider       String             @default("browser")
  voiceId             String?
  voiceGender         String?
  voiceLanguage       String             @default("en")
  speakingStyle       String             @default("natural")
  speakingSpeed       Float              @default(1.0)

  // Phase 3: Patient Realistic AI Avatar Profile
  avatarProvider      String             @default("webgl-3d")
  avatarId            String?
  avatarGender        String?
  avatarAgeGroup      String?
  avatarStyle         String             @default("realistic")

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  clinicalData        PatientCaseClinicalData?
  rubric              ClinicalCaseRubric?
  sessions            PracticeSession[]
  examStations        ExamStation[]

  @@map("patient_cases")
}

model PatientCaseClinicalData {
  id                  String      @id @default(uuid())
  patientCaseId       String      @unique
  patientCase         PatientCase @relation(fields: [patientCaseId], references: [id], onDelete: Cascade)

  medicalHistory      String?
  medicationHistory   String?
  allergyHistory      String?
  familyHistory       String?
  socialHistory       String?
  symptomDetails      String?
  redFlags            String?
  hiddenDiagnosis     String?
  expectedHistory     String?
  learningObjectives  String?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@map("patient_case_clinical_data")
}

model PracticeSession {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientCaseId   String
  patientCase     PatientCase   @relation(fields: [patientCaseId], references: [id])
  status          String        @default("active")
  
  // Phase 2: Session Voice and Language Settings
  language        String        @default("en")
  voiceEnabled    Boolean       @default(true)
  voiceProvider   String?

  // Phase 3: Session Avatar Settings
  avatarEnabled   Boolean       @default(true)
  avatarProvider  String?
  avatarId        String?
  avatarSessionId String?

  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  duration        Int?
createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  messages        ConversationMessage[]
  attempts        PracticeAttempt[]

  @@map("practice_sessions")
}

model ConversationMessage {
  id                String          @id @default(uuid())
  practiceSessionId String
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  sender            String
  message           String
  
  // Phase 2: Voice message metadata
  messageType       String          @default("text")
  audioUrl          String?
  transcription     String?

  // Phase 3: Emotion and Avatar metadata
  emotion           String?
  emotionIntensity  Float?

  // Phase 4: Silent Intent & Category metadata (not leaked to student during session)
  detectedCategory  String?
  detectedIntent    String?

  timestamp         DateTime        @default(now())

  @@map("conversation_messages")
}

// ==========================================
// PHASE 4: CLINICAL INTELLIGENCE & EVALUATION
// ==========================================

model ClinicalCaseRubric {
  id                  String       @id @default(uuid())
  patientCaseId       String       @unique
  patientCase         PatientCase  @relation(fields: [patientCaseId], references: [id], onDelete: Cascade)
  version             Int          @default(1)
  learningObjectives  String?      // JSON array of strings
  scoringWeights      String?      // JSON: { historyTaking: 40, communication: 20, clinicalReasoning: 20, patientCenteredness: 10, consultationStructure: 10 }
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  items               RubricItem[]

  @@map("clinical_case_rubrics")
}

model RubricItem {
  id                  String             @id @default(uuid())
  rubricId            String
  rubric              ClinicalCaseRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  category            String             // e.g. "History of Presenting Complaint", "Associated Symptoms", "Past Medical History", "Red Flags", etc.
  title               String             // e.g. "Pain Location & Character"
  description         String?
  intent              String             // e.g. "pain_location", "pain_radiation", "cardiac_risk_factors"
  sampleQuestions     String?            // JSON array of sample questions
  importance          String             @default("required") // "required", "recommended", "red_flag"
  clinicalRationale   String?            // Why this matters clinically in this case
  weight              Float              @default(1.0)
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  evidence            EvaluationEvidence[]

  @@map("rubric_items")
}

model PracticeAttempt {
  id                        String              @id @default(uuid())
  practiceSessionId         String
  practiceSession           PracticeSession     @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  attemptNumber             Int                 @default(1)
  startedAt                 DateTime            @default(now())
  endedAt                   DateTime?
  duration                  Int?
  
  // High-level scores (0 - 100)
  historyScore              Float?
  communicationScore        Float?
  reasoningScore            Float?
  patientCenterednessScore  Float?
  structureScore            Float?
  overallScore              Float?
  status                    String              @default("completed") // "completed", "evaluated"

  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  evaluation                ClinicalEvaluation?

  @@map("practice_attempts")
}

model ClinicalEvaluation {
  id                        String              @id @default(uuid())
  practiceAttemptId         String              @unique
  practiceAttempt           PracticeAttempt     @relation(fields: [practiceAttemptId], references: [id], onDelete: Cascade)
  
  historyScore              Float
  communicationScore        Float
  reasoningScore            Float
  patientCenterednessScore  Float
  structureScore            Float
  overallScore              Float

  coveredCount              Int                 @default(0)
  partialCount              Int                 @default(0)
  missedCount               Int                 @default(0)
  totalCount                Int                 @default(0)

  overallSummary            String
  strengths                 String?             // JSON array of strings
  improvements              String?             // JSON array of strings
  communicationFeedback     String?             // JSON object
  reasoningFeedback         String?             // JSON object
  structureFeedback         String?             // JSON object
  missedQuestions           String?             // JSON array of strings
  prematureDiagnosis        Boolean             @default(false)
  
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  evidence                  EvaluationEvidence[]

  @@map("clinical_evaluations")
}

model EvaluationEvidence {
  id                        String              @id @default(uuid())
  clinicalEvaluationId      String
  clinicalEvaluation        ClinicalEvaluation  @relation(fields: [clinicalEvaluationId], references: [id], onDelete: Cascade)
  rubricItemId              String?
  rubricItem                RubricItem?         @relation(fields: [rubricItemId], references: [id], onDelete: SetNull)
  category                  String
  title                     String
  intent                    String?
  status                    String              // "covered", "partial", "missed", "not_applicable", "insufficient_evidence"
  studentQuote              String?
  feedback                  String
  importance                String              @default("required") // "required", "recommended", "red_flag"

  createdAt                 DateTime            @default(now())

  @@map("evaluation_evidences")
}

// ==========================================
// PHASE 5: OSCE & CLINICAL EXAMINATION MODE
// ==========================================

model ClinicalExam {
  id                    String        @id @default(uuid())
  title                 String
  slug                  String        @unique
  description           String?
  instructions          String?       // General exam instructions / rules
  durationMinutes       Int           @default(30)
  stationCount          Int           @default(5)
  difficulty            String        @default("intermediate") // "beginner", "intermediate", "advanced"
  status                String        @default("published") // "draft", "published", "archived"
  
  // Exam policy configurations
  voiceRequired         Boolean       @default(false)
  showLiveTranscript    Boolean       @default(false)
  fullscreenRequired    Boolean       @default(false)
  showDetailedFeedback  Boolean       @default(true)
  allowRetake           Boolean       @default(true)
  maxAttempts           Int?          @default(3)
  passingPercentage     Float         @default(60.0)

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  stations              ExamStation[]
  attempts              ExamAttempt[]

  @@map("clinical_exams")
}

model ExamStation {
  id                    String        @id @default(uuid())
  clinicalExamId        String
  clinicalExam          ClinicalExam  @relation(fields: [clinicalExamId], references: [id], onDelete: Cascade)
  patientCaseId         String
  patientCase           PatientCase   @relation(fields: [patientCaseId], references: [id])
  stationNumber         Int
  title                 String        // e.g. "Station 1: Chest Pain — Focused History"
  instructions          String?       // Detailed station background (examiner view)
  candidateInstructions String        // Displayed to student outside/inside station
  timeLimitSeconds      Int           @default(360) // e.g. 6 minutes (360s)
  passingScore          Float         @default(12.0)

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  osceRubric            OSCERubric?
  stationAttempts       StationAttempt[]

  @@map("exam_stations")
}

model OSCERubric {
  id                    String            @id @default(uuid())
  stationId             String            @unique
  station               ExamStation       @relation(fields: [stationId], references: [id], onDelete: Cascade)
  title                 String            @default("Station OSCE Marking Scheme")
  totalMarks            Float             @default(20.0)
  passingMarks          Float             @default(12.0)

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  items                 OSCERubricItem[]

  @@map("osce_rubrics")
}

model OSCERubricItem {
  id                    String            @id @default(uuid())
  rubricId              String
  rubric                OSCERubric        @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  category              String            // e.g. "History Taking", "Communication", "Red Flags", "Clinical Reasoning"
  criterion             String            // e.g. "Identifies pain onset and temporal progression"
  description           String?
  intent                String?           // e.g. "pain_onset_duration"
  marks                 Float             @default(1.0)
  required              Boolean           @default(true)
  isCritical            Boolean           @default(false) // Critical safety fail item
  severity              String            @default("important") // "critical", "important", "supplementary"

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  evaluationItems       OSCEEvaluationItem[]

  @@map("osce_rubric_items")
}

model ExamAttempt {
  id                    String                @id @default(uuid())
  userId                String
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicalExamId        String
  clinicalExam          ClinicalExam          @relation(fields: [clinicalExamId], references: [id], onDelete: Cascade)
  attemptNumber         Int                   @default(1)
  language              String                @default("en") // "en" | "bn"
  status                String                @default("not_started") // "not_started", "in_progress", "completed", "abandoned"
  startedAt             DateTime              @default(now())
  completedAt           DateTime?
  
  totalScore            Float?
  totalMarks            Float?
  percentage            Float?
  outcome               String?               // "passed", "not_passed", "review_required"

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  stationAttempts       StationAttempt[]
  integrityEvents       ExamIntegrityEvent[]

  @@map("exam_attempts")
}

model StationAttempt {
  id                    String                @id @default(uuid())
  examAttemptId         String
  examAttempt           ExamAttempt           @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  stationId             String
  station               ExamStation           @relation(fields: [stationId], references: [id], onDelete: Cascade)
  status                String                @default("ready") // "ready", "active", "time_up", "completed", "evaluated"
  startedAt             DateTime?
  deadline              DateTime?             // Authoritative server deadline
  completedAt           DateTime?
  
  score                 Float?
  maximumScore          Float?
  percentage            Float?
  outcome               String?               // "passed", "not_passed", "review_required"

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  messages              StationMessage[]
  evaluation            OSCEEvaluation?

  @@map("station_attempts")
}

model StationMessage {
  id                    String                @id @default(uuid())
  stationAttemptId      String
  stationAttempt        StationAttempt        @relation(fields: [stationAttemptId], references: [id], onDelete: Cascade)
  sender                String                // "student" | "patient"
  message               String
  messageType           String                @default("voice") // "voice" | "text"
  audioUrl              String?
  transcription         String?
  emotion               String?
  emotionIntensity      Float?
  detectedCategory      String?
  detectedIntent        String?
  timestamp             DateTime              @default(now())

  @@map("station_messages")
}

model OSCEEvaluation {
  id                    String                @id @default(uuid())
  stationAttemptId      String                @unique
  stationAttempt        StationAttempt        @relation(fields: [stationAttemptId], references: [id], onDelete: Cascade)
  summary               String
  strengths             String?               // JSON array of strings
  improvements          String?               // JSON array of strings
  score                 Float
  totalMarks            Float
  percentage            Float
  hasCriticalFailure    Boolean               @default(false)

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  items                 OSCEEvaluationItem[]

  @@map("osce_evaluations")
}

model OSCEEvaluationItem {
  id                    String                @id @default(uuid())
  osceEvaluationId      String
  osceEvaluation        OSCEEvaluation        @relation(fields: [osceEvaluationId], references: [id], onDelete: Cascade)
  rubricItemId          String
  rubricItem            OSCERubricItem        @relation(fields: [rubricItemId], references: [id], onDelete: Cascade)
  status                String                // "achieved", "partially_achieved", "not_achieved", "not_applicable", "insufficient_evidence"
  marksAwarded          Float
  maximumMarks          Float
  evidence              String?               // Exact quote from consultation
  feedback              String?

  createdAt             DateTime              @default(now())

  @@map("osce_evaluation_items")
}

model ExamIntegrityEvent {
  id                    String                @id @default(uuid())
  examAttemptId         String
  examAttempt           ExamAttempt           @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  stationAttemptId      String?
  eventType             String                // "tab_hidden", "tab_visible", "fullscreen_entered", "fullscreen_exited", "microphone_disabled", "microphone_enabled", "connection_lost", "connection_restored"
  metadata              String?               // JSON string
  timestamp             DateTime              @default(now())

  @@map("exam_integrity_events")
}
