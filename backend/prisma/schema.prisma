generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            String    @default("student")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        PracticeSession[]
  examAttempts    ExamAttempt[]
  studyMaterials  StudyMaterial[]
  studyNotes      StudyNote[]
  flashcardDecks  FlashcardDeck[]
  tutorConversations TutorConversation[]
  mcqPracticeSessions MCQPracticeSession[]
  vivaSessions    VivaSession[]
  studySessions   StudySession[]
  flashcardReviewStates FlashcardReviewState[]
  mistakeRecords        MistakeRecord[]
  topicMasteries        TopicMastery[]
  vivaConceptPerformances VivaConceptPerformance[]
  studyPlans            StudyPlan[]
  studyPlanTasks        StudyPlanTask[]
  learningStreak        LearningStreak?
  learningRecommendations LearningRecommendation[]
  learningEvents        LearningEvent[]
  spacedRepetitionSettings SpacedRepetitionSettings?

  @@map("users")
}

model PatientCase {
  id                  String             @id @default(uuid())
  title               String
  slug                String             @unique
  description         String?
  category            String             @default("General Medicine")
  difficulty          String             @default("beginner")
  estimatedDuration   Int                @default(20)
  patientName         String
  patientAge          Int
  patientGender       String
  chiefComplaint      String
  caseSummary         String?
  personality         String             @default("calm")
  isActive            Boolean            @default(true)
  
  // Phase 2: Patient Voice Profile
  voiceProvider       String             @default("browser")
  voiceId             String?
  voiceGender         String?
  voiceLanguage       String             @default("en")
  speakingStyle       String             @default("natural")
  speakingSpeed       Float              @default(1.0)

  // Phase 3: Patient Realistic AI Avatar Profile
  avatarProvider      String             @default("webgl-3d")
  avatarId            String?
  avatarGender        String?
  avatarAgeGroup      String?
  avatarStyle         String             @default("realistic")

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  clinicalData        PatientCaseClinicalData?
  rubric              ClinicalCaseRubric?
  sessions            PracticeSession[]
  examStations        ExamStation[]

  @@map("patient_cases")
}

model PatientCaseClinicalData {
  id                  String      @id @default(uuid())
  patientCaseId       String      @unique
  patientCase         PatientCase @relation(fields: [patientCaseId], references: [id], onDelete: Cascade)

  medicalHistory      String?
  medicationHistory   String?
  allergyHistory      String?
  familyHistory       String?
  socialHistory       String?
  symptomDetails      String?
  redFlags            String?
  hiddenDiagnosis     String?
  expectedHistory     String?
  learningObjectives  String?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@map("patient_case_clinical_data")
}

model PracticeSession {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientCaseId   String
  patientCase     PatientCase   @relation(fields: [patientCaseId], references: [id])
  status          String        @default("active")
  
  // Phase 2: Session Voice and Language Settings
  language        String        @default("en")
  voiceEnabled    Boolean       @default(true)
  voiceProvider   String?

  // Phase 3: Session Avatar Settings
  avatarEnabled   Boolean       @default(true)
  avatarProvider  String?
  avatarId        String?
  avatarSessionId String?

  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  duration        Int?
createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  messages        ConversationMessage[]
  attempts        PracticeAttempt[]

  @@map("practice_sessions")
}

model ConversationMessage {
  id                String          @id @default(uuid())
  practiceSessionId String
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  sender            String
  message           String
  
  // Phase 2: Voice message metadata
  messageType       String          @default("text")
  audioUrl          String?
  transcription     String?

  // Phase 3: Emotion and Avatar metadata
  emotion           String?
  emotionIntensity  Float?

  // Phase 4: Silent Intent & Category metadata (not leaked to student during session)
  detectedCategory  String?
  detectedIntent    String?

  timestamp         DateTime        @default(now())

  @@map("conversation_messages")
}

// ==========================================
// PHASE 4: CLINICAL INTELLIGENCE & EVALUATION
// ==========================================

model ClinicalCaseRubric {
  id                  String       @id @default(uuid())
  patientCaseId       String       @unique
  patientCase         PatientCase  @relation(fields: [patientCaseId], references: [id], onDelete: Cascade)
  version             Int          @default(1)
  learningObjectives  String?      // JSON array of strings
  scoringWeights      String?      // JSON: { historyTaking: 40, communication: 20, clinicalReasoning: 20, patientCenteredness: 10, consultationStructure: 10 }
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  items               RubricItem[]

  @@map("clinical_case_rubrics")
}

model RubricItem {
  id                  String             @id @default(uuid())
  rubricId            String
  rubric              ClinicalCaseRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  category            String             // e.g. "History of Presenting Complaint", "Associated Symptoms", "Past Medical History", "Red Flags", etc.
  title               String             // e.g. "Pain Location & Character"
  description         String?
  intent              String             // e.g. "pain_location", "pain_radiation", "cardiac_risk_factors"
  sampleQuestions     String?            // JSON array of sample questions
  importance          String             @default("required") // "required", "recommended", "red_flag"
  clinicalRationale   String?            // Why this matters clinically in this case
  weight              Float              @default(1.0)
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  evidence            EvaluationEvidence[]

  @@map("rubric_items")
}

model PracticeAttempt {
  id                        String              @id @default(uuid())
  practiceSessionId         String
  practiceSession           PracticeSession     @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  attemptNumber             Int                 @default(1)
  startedAt                 DateTime            @default(now())
  endedAt                   DateTime?
  duration                  Int?
  
  // High-level scores (0 - 100)
  historyScore              Float?
  communicationScore        Float?
  reasoningScore            Float?
  patientCenterednessScore  Float?
  structureScore            Float?
  overallScore              Float?
  status                    String              @default("completed") // "completed", "evaluated"

  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  evaluation                ClinicalEvaluation?

  @@map("practice_attempts")
}

model ClinicalEvaluation {
  id                        String              @id @default(uuid())
  practiceAttemptId         String              @unique
  practiceAttempt           PracticeAttempt     @relation(fields: [practiceAttemptId], references: [id], onDelete: Cascade)
  
  historyScore              Float
  communicationScore        Float
  reasoningScore            Float
  patientCenterednessScore  Float
  structureScore            Float
  overallScore              Float

  coveredCount              Int                 @default(0)
  partialCount              Int                 @default(0)
  missedCount               Int                 @default(0)
  totalCount                Int                 @default(0)

  overallSummary            String
  strengths                 String?             // JSON array of strings
  improvements              String?             // JSON array of strings
  communicationFeedback     String?             // JSON object
  reasoningFeedback         String?             // JSON object
  structureFeedback         String?             // JSON object
  missedQuestions           String?             // JSON array of strings
  prematureDiagnosis        Boolean             @default(false)
  
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  evidence                  EvaluationEvidence[]

  @@map("clinical_evaluations")
}

model EvaluationEvidence {
  id                        String              @id @default(uuid())
  clinicalEvaluationId      String
  clinicalEvaluation        ClinicalEvaluation  @relation(fields: [clinicalEvaluationId], references: [id], onDelete: Cascade)
  rubricItemId              String?
  rubricItem                RubricItem?         @relation(fields: [rubricItemId], references: [id], onDelete: SetNull)
  category                  String
  title                     String
  intent                    String?
  status                    String              // "covered", "partial", "missed", "not_applicable", "insufficient_evidence"
  studentQuote              String?
  feedback                  String
  importance                String              @default("required") // "required", "recommended", "red_flag"

  createdAt                 DateTime            @default(now())

  @@map("evaluation_evidences")
}

// ==========================================
// PHASE 5: OSCE & CLINICAL EXAMINATION MODE
// ==========================================

model ClinicalExam {
  id                    String        @id @default(uuid())
  title                 String
  slug                  String        @unique
  description           String?
  instructions          String?       // General exam instructions / rules
  durationMinutes       Int           @default(30)
  stationCount          Int           @default(5)
  difficulty            String        @default("intermediate") // "beginner", "intermediate", "advanced"
  status                String        @default("published") // "draft", "published", "archived"
  
  // Exam policy configurations
  voiceRequired         Boolean       @default(false)
  showLiveTranscript    Boolean       @default(false)
  fullscreenRequired    Boolean       @default(false)
  showDetailedFeedback  Boolean       @default(true)
  allowRetake           Boolean       @default(true)
  maxAttempts           Int?          @default(3)
  passingPercentage     Float         @default(60.0)

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  stations              ExamStation[]
  attempts              ExamAttempt[]

  @@map("clinical_exams")
}

model ExamStation {
  id                    String        @id @default(uuid())
  clinicalExamId        String
  clinicalExam          ClinicalExam  @relation(fields: [clinicalExamId], references: [id], onDelete: Cascade)
  patientCaseId         String
  patientCase           PatientCase   @relation(fields: [patientCaseId], references: [id])
  stationNumber         Int
  title                 String        // e.g. "Station 1: Chest Pain — Focused History"
  instructions          String?       // Detailed station background (examiner view)
  candidateInstructions String        // Displayed to student outside/inside station
  timeLimitSeconds      Int           @default(360) // e.g. 6 minutes (360s)
  passingScore          Float         @default(12.0)

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  osceRubric            OSCERubric?
  stationAttempts       StationAttempt[]

  @@map("exam_stations")
}

model OSCERubric {
  id                    String            @id @default(uuid())
  stationId             String            @unique
  station               ExamStation       @relation(fields: [stationId], references: [id], onDelete: Cascade)
  title                 String            @default("Station OSCE Marking Scheme")
  totalMarks            Float             @default(20.0)
  passingMarks          Float             @default(12.0)

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  items                 OSCERubricItem[]

  @@map("osce_rubrics")
}

model OSCERubricItem {
  id                    String            @id @default(uuid())
  rubricId              String
  rubric                OSCERubric        @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  category              String            // e.g. "History Taking", "Communication", "Red Flags", "Clinical Reasoning"
  criterion             String            // e.g. "Identifies pain onset and temporal progression"
  description           String?
  intent                String?           // e.g. "pain_onset_duration"
  marks                 Float             @default(1.0)
  required              Boolean           @default(true)
  isCritical            Boolean           @default(false) // Critical safety fail item
  severity              String            @default("important") // "critical", "important", "supplementary"

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  evaluationItems       OSCEEvaluationItem[]

  @@map("osce_rubric_items")
}

model ExamAttempt {
  id                    String                @id @default(uuid())
  userId                String
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicalExamId        String
  clinicalExam          ClinicalExam          @relation(fields: [clinicalExamId], references: [id], onDelete: Cascade)
  attemptNumber         Int                   @default(1)
  language              String                @default("en") // "en" | "bn"
  status                String                @default("not_started") // "not_started", "in_progress", "completed", "abandoned"
  startedAt             DateTime              @default(now())
  completedAt           DateTime?
  
  totalScore            Float?
  totalMarks            Float?
  percentage            Float?
  outcome               String?               // "passed", "not_passed", "review_required"

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  stationAttempts       StationAttempt[]
  integrityEvents       ExamIntegrityEvent[]

  @@map("exam_attempts")
}

model StationAttempt {
  id                    String                @id @default(uuid())
  examAttemptId         String
  examAttempt           ExamAttempt           @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  stationId             String
  station               ExamStation           @relation(fields: [stationId], references: [id], onDelete: Cascade)
  status                String                @default("ready") // "ready", "active", "time_up", "completed", "evaluated"
  startedAt             DateTime?
  deadline              DateTime?             // Authoritative server deadline
  completedAt           DateTime?
  
  score                 Float?
  maximumScore          Float?
  percentage            Float?
  outcome               String?               // "passed", "not_passed", "review_required"

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  messages              StationMessage[]
  evaluation            OSCEEvaluation?

  @@map("station_attempts")
}

model StationMessage {
  id                    String                @id @default(uuid())
  stationAttemptId      String
  stationAttempt        StationAttempt        @relation(fields: [stationAttemptId], references: [id], onDelete: Cascade)
  sender                String                // "student" | "patient"
  message               String
  messageType           String                @default("voice") // "voice" | "text"
  audioUrl              String?
  transcription         String?
  emotion               String?
  emotionIntensity      Float?
  detectedCategory      String?
  detectedIntent        String?
  timestamp             DateTime              @default(now())

  @@map("station_messages")
}

model OSCEEvaluation {
  id                    String                @id @default(uuid())
  stationAttemptId      String                @unique
  stationAttempt        StationAttempt        @relation(fields: [stationAttemptId], references: [id], onDelete: Cascade)
  summary               String
  strengths             String?               // JSON array of strings
  improvements          String?               // JSON array of strings
  score                 Float
  totalMarks            Float
  percentage            Float
  hasCriticalFailure    Boolean               @default(false)

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  items                 OSCEEvaluationItem[]

  @@map("osce_evaluations")
}

model OSCEEvaluationItem {
  id                    String                @id @default(uuid())
  osceEvaluationId      String
  osceEvaluation        OSCEEvaluation        @relation(fields: [osceEvaluationId], references: [id], onDelete: Cascade)
  rubricItemId          String
  rubricItem            OSCERubricItem        @relation(fields: [rubricItemId], references: [id], onDelete: Cascade)
  status                String                // "achieved", "partially_achieved", "not_achieved", "not_applicable", "insufficient_evidence"
  marksAwarded          Float
  maximumMarks          Float
  evidence              String?               // Exact quote from consultation
  feedback              String?

  createdAt             DateTime              @default(now())

  @@map("osce_evaluation_items")
}

model ExamIntegrityEvent {
  id                    String                @id @default(uuid())
  examAttemptId         String
  examAttempt           ExamAttempt           @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  stationAttemptId      String?
  eventType             String                // "tab_hidden", "tab_visible", "fullscreen_entered", "fullscreen_exited", "microphone_disabled", "microphone_enabled", "connection_lost", "connection_restored"
  metadata              String?               // JSON string
  timestamp             DateTime              @default(now())

  @@map("exam_integrity_events")
}


// ==========================================
// PHASE 6: SMART LEARNING HUB & ACADEMIC MODELS
// ==========================================

model MedicalSubject {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  category    String   // "Pre-Clinical", "Para-Clinical", "Clinical"
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("medical_subjects")
}

model StudyMaterial {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  originalFileName String
  fileType         String   // "pdf", "txt", "docx"
  fileSize         Int
  filePath         String?
  subject          String
  topic            String?
  subtopic         String?
  tags             String?
  description      String?
  extractedText    String?
  processingStatus String   @default("READY") // "UPLOADING", "PROCESSING", "READY", "FAILED"
  reviewStatus     String   @default("APPROVED") // "PENDING", "REVIEWED", "APPROVED", "REJECTED"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  notes              StudyNote[]
  flashcardDecks     FlashcardDeck[]
  questionBanks      QuestionBank[]
  tutorConversations TutorConversation[]
  studySessions      StudySession[]

  @@map("study_materials")
}

model StudyNote {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId   String?
  material     StudyMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  title        String
  content      String
  subject      String
  topic        String?
  tags         String?
  sourceType   String         @default("PERSONAL") // "PERSONAL", "AI_GENERATED", "MATERIAL_BASED"
  isPinned     Boolean        @default(false)
  isFavorite   Boolean        @default(false)
  reviewStatus String         @default("APPROVED")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("study_notes")
}

model TutorConversation {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId  String?
  material    StudyMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  subject     String?
  topic       String?
  mode        String         @default("EXPLAIN") // "EXPLAIN", "TEACH", "QUIZ_ME", "VIVA_ME", "REVISE"
  title       String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages    TutorMessage[]

  @@map("tutor_conversations")
}

model TutorMessage {
  id              String            @id @default(uuid())
  conversationId  String
  conversation    TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String            // "user" | "assistant" | "system"
  content         String
  sourceReference String?
  createdAt       DateTime          @default(now())

  @@map("tutor_messages")
}

model FlashcardDeck {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId   String?
  material     StudyMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  title        String
  subject      String
  topic        String?
  description  String?
  reviewStatus String         @default("APPROVED")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  flashcards   Flashcard[]
  reviews      FlashcardReview[]

  @@map("flashcard_decks")
}

model Flashcard {
  id              String          @id @default(uuid())
  deckId          String
  deck            FlashcardDeck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  question        String
  answer          String
  explanation     String?
  sourceReference String?
  difficulty      String          @default("medium") // "easy", "medium", "hard"
  reviewStatus    String          @default("APPROVED")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  reviews         FlashcardReview[]
  reviewStates    FlashcardReviewState[]

  @@map("flashcards")
}

model FlashcardReview {
  id         String        @id @default(uuid())
  userId     String
  deckId     String
  deck       FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardId     String
  card       Flashcard     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating     String        // "again", "hard", "good", "easy"
  reviewedAt DateTime      @default(now())

  @@map("flashcard_reviews")
}

model QuestionBank {
  id           String         @id @default(uuid())
  userId       String?
  materialId   String?
  material     StudyMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  subject      String
  topic        String?
  title        String
  description  String?
  reviewStatus String         @default("APPROVED")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  questions        MCQQuestion[]
  practiceSessions MCQPracticeSession[]

  @@map("question_banks")
}

model MCQQuestion {
  id              String       @id @default(uuid())
  questionBankId  String
  questionBank    QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  question        String
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctOption   String       // "A", "B", "C", "D"
  explanation     String
  difficulty      String       @default("medium") // "easy", "medium", "hard"
  subtopic        String?
  concept         String?
  questionType    String       @default("Conceptual") // "Recall", "Conceptual", "Clinical Scenario", "Application", "Reasoning", "Mixed"
  sourceReference String?
  reviewStatus    String       @default("APPROVED")
  createdAt       DateTime     @default(now())

  @@map("mcq_questions")
}

model MCQPracticeSession {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionBankId String?
  questionBank   QuestionBank? @relation(fields: [questionBankId], references: [id], onDelete: SetNull)
  subject        String
  topic          String?
  totalQuestions Int
  correctAnswers Int           @default(0)
  score          Float         @default(0.0)
  accuracy       Float         @default(0.0)
  status         String        @default("active") // "active", "completed"
  startedAt      DateTime      @default(now())
  completedAt    DateTime?

  answers        MCQAnswer[]

  @@map("mcq_practice_sessions")
}

model MCQAnswer {
  id             String             @id @default(uuid())
  sessionId      String
  session        MCQPracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId     String
  selectedOption String             // "A", "B", "C", "D"
  isCorrect      Boolean
  createdAt      DateTime           @default(now())

  @@map("mcq_answers")
}

model VivaSession {
  id                   String         @id @default(uuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject              String
  topic                String
  difficulty           String         @default("medium") // "easy", "medium", "hard"
  mode                 String         @default("TEXT") // "TEXT", "VOICE"
  status               String         @default("in_progress") // "in_progress", "completed"
  totalQuestions       Int            @default(5)
  currentQuestionIndex Int            @default(0)
  overallScore         Float?
  startedAt            DateTime       @default(now())
  completedAt          DateTime?

  questions            VivaQuestion[]

  @@map("viva_sessions")
}

model VivaQuestion {
  id              String       @id @default(uuid())
  sessionId       String
  session         VivaSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionNumber  Int
  question        String
  expectedConcepts String      // JSON array string
  sourceReference String?
  createdAt       DateTime     @default(now())

  response        VivaResponse?

  @@map("viva_questions")
}

model VivaResponse {
  id                 String       @id @default(uuid())
  questionId         String       @unique
  question           VivaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responseText       String
  responseAudioUrl   String?
  score              Float        @default(0.0)
  keyConceptsCovered String?      // JSON array string
  conceptsMissed     String?      // JSON array string
  conceptsIncorrect  String?      // JSON array string
  clarityScore       Float        @default(0.0)
  feedback           String?
  createdAt          DateTime     @default(now())

  @@map("viva_responses")
}

model StudySession {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId      String?
  material        StudyMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  subject         String
  topic           String?
  activityType    String         // "READING", "NOTES", "MCQ", "FLASHCARD", "VIVA", "AI_TUTOR"
  durationSeconds Int            @default(0)
  startedAt       DateTime       @default(now())
  endedAt         DateTime?

  @@map("study_sessions")
}


// ============================================================================
// PHASE 7: ADAPTIVE LEARNING & SMART REVISION ENGINE MODELS
// ============================================================================

model FlashcardReviewState {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId          String
  card            Flashcard     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  repetitionCount Int           @default(0)
  intervalDays    Float         @default(0)
  easeFactor      Float         @default(2.5)
  dueAt           DateTime      @default(now())
  lastReviewedAt  DateTime?
  lastRating      String?       // "AGAIN", "HARD", "GOOD", "EASY"
  lapses          Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, cardId])
  @@map("flashcard_review_states")
}

model MistakeRecord {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId      String
  selectedAnswer  String
  correctAnswer   String
  conceptId       String?
  conceptName     String?
  subject         String?
  topic           String?
  explanation     String?
  sourceReference String?
  attemptNumber   Int           @default(1)
  reviewed        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("mistake_records")
}

model TopicMastery {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject           String
  topic             String
  status            String        @default("NEW") // "NEW", "LEARNING", "REVIEW", "STRONG"
  masteryPercentage Float         @default(0.0)
  mcqAccuracy       Float         @default(0.0)
  flashcardRetention Float        @default(0.0)
  vivaCoverage      Float         @default(0.0)
  totalAttempts     Int           @default(0)
  lastStudiedAt     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([userId, subject, topic])
  @@map("topic_masteries")
}

model VivaConceptPerformance {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vivaSessionId   String
  conceptName     String
  status          String        // "COVERED", "PARTIALLY_COVERED", "MISSED", "INCORRECT"
  feedback        String?
  createdAt       DateTime      @default(now())

  @@map("viva_concept_performances")
}

model StudyPlan {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  goal              String
  subjects          String          // JSON array string
  dailyTimeMinutes  Int             @default(60)
  availableDays     String          // JSON array string
  examDate          DateTime?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tasks             StudyPlanTask[]

  @@map("study_plans")
}

model StudyPlanTask {
  id                String          @id @default(uuid())
  planId            String
  plan              StudyPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek         String          // "Monday", "Tuesday", etc.
  scheduledDate     DateTime?
  subject           String
  topic             String
  taskType          String          // "READING", "MCQ", "FLASHCARD", "VIVA", "REVISION"
  durationMinutes   Int             @default(30)
  isCompleted       Boolean         @default(false)
  completedAt       DateTime?
  createdAt         DateTime        @default(now())

  @@map("study_plan_tasks")
}

model LearningStreak {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak   Int           @default(0)
  longestStreak   Int           @default(0)
  lastActiveDate  String?       // "YYYY-MM-DD"
  activeDaysCount Int           @default(0)
  updatedAt       DateTime      @updatedAt

  @@map("learning_streaks")
}

model LearningRecommendation {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String        // "FLASHCARD_DUE", "WEAK_CONCEPT", "MCQ_REINFORCE", "INACTIVITY", "VIVA_REVISION"
  title           String
  description     String
  subject         String?
  topic           String?
  actionUrl       String
  priority        String        @default("MEDIUM") // "HIGH", "MEDIUM", "LOW"
  isDismissed     Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@map("learning_recommendations")
}

model LearningEvent {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType       String        // "MATERIAL_OPENED", "NOTE_CREATED", "FLASHCARD_REVIEWED", "MCQ_STARTED", "MCQ_ANSWERED", "MCQ_COMPLETED", "VIVA_STARTED", "VIVA_COMPLETED", "TOPIC_STUDIED", "REVISION_COMPLETED", "AI_TUTOR_USED", "STUDY_PLAN_TASK_COMPLETED"
  entityId        String?
  subject         String?
  topic           String?
  metadata        String?       // JSON string
  createdAt       DateTime      @default(now())

  @@map("learning_events")
}

model SpacedRepetitionSettings {
  id                     String        @id @default(uuid())
  userId                 String        @unique
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  newCardsPerDay         Int           @default(20)
  maxReviewsPerDay       Int           @default(50)
  reminderEnabled        Boolean       @default(true)
  preferredReminderTime  String        @default("09:00")
  updatedAt              DateTime      @updatedAt

  @@map("spaced_repetition_settings")
}
